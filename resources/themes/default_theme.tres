[gd_resource type="Resource" script_class="UITheme" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/core/ui_theme.gd" id="1_theme_script"]

[resource]
script = ExtResource("1_theme_script")
theme_name = "Fantasy Default"
theme_description = "Medieval fantasy theme with parchment textures and ornate styling"

; Color Palette
primary_color = Color(0.8, 0.7, 0.5, 1)
secondary_color = Color(0.4, 0.3, 0.2, 1)

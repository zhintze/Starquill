font_size_body = 32
font_size_button = 32
font_size_small = 24

; Textures
panel_texture = null
button_texture = null
border_texture = null
slot_texture = null
icon_frame_texture = null

; Panel Style
panel_border_width = 8
panel_corner_radius = 16
panel_shadow_size = 8
panel_shadow_color = Color(0, 0, 0, 0.5)

; Button Style
button_border_width = 4
button_corner_radius = 12
button_padding_horizontal = 32
button_padding_vertical = 16
button_hover_scale = 1.05

; Equipment Slot Style
slot_size = Vector2i(128, 128)
slot_border_width = 4
slot_border_color = Color(0.4, 0.3, 0.2, 1)
slot_border_color_highlight = Color(0.9, 0.7, 0.3, 1)

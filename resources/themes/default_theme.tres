; Background Colors
bg_primary = Color(0.85, 0.75, 0.6, 1)
bg_secondary = Color(0.75, 0.65, 0.5, 1)
bg_overlay = Color(0.1, 0.08, 0.05, 0.85)

; Border Colors
border_panel = Color(0.4, 0.3, 0.2, 1)
border_slot = Color(0.35, 0.28, 0.18, 1)

@startuml Class-DisplaySystem
!theme plain
title Display System - Visual Layer Architecture

class CharacterDisplay {
  - _character: Character
  - _piece_nodes: Array[TextureRect]
  - _content_size: Vector2
  - _is_facing_left: bool

  - bg_panel: Panel
  - layer_root: Control

  + set_character(c: Character): void
  + set_facing_left(facing_left): void

  - _redraw(): void
  - _update_flip_state(): void
  - _apply_bottom_center_anchor(): void
  - _update_global_scale(): void
}

class DisplayPiece {
  + texture: Texture2D
  + layer: int
  + modulate: Color
  + scale: Vector2
  + rotation_degrees: float
  + offset: Vector2
  + flip_h: bool
  + flip_v: bool
  + is_offhand_weapon: bool

  {static} + from_path(path, layer, tint): DisplayPiece
}

class DisplayBuilder <<Singleton>> {
  {static} - SPECIES_IMG_DIR: String
  {static} - EQUIPMENT_IMG_DIR: String
  {static} - WEAPONS_IMG_DIR: String

  + build_character_display(character): Array[DisplayPiece]
  + build_species_display(species): Array[DisplayPiece]
  + build_equipment_display(equipment): Array[DisplayPiece]

  + build_species_pieces(instance): Array[DisplayPiece]
  + build_equipment_pieces(equipment): EquipmentResult

  - _add_species_field(field, token, pieces, color, instance)
  - _deduplicate_equipment_by_type(equipment): Array
}

class "DisplayBuilder.EquipmentResult" as EquipmentResult {
  + pieces: Array[DisplayPiece]
  + hidden_species_layers: PackedInt32Array
}

class LayerManager <<Singleton>> {
  - _layer_mappings: Dictionary

  + get_layer_mapping(type_code): Array[int]
  + merge_and_sort_pieces(species, equipment, hidden): Array
  + sort_pieces_by_layer(pieces): Array
  + apply_layer_tints(pieces, color_map): Array
  + filter_hidden_layers(pieces, hidden): Array
}

enum ImageIdKind {
  EMPTY
  INVALID
  STATIC
  MODULAR_FULL
  MODULAR_GROUP_ONLY
}

class ImageId {
  {static} + parse(token): Dictionary
  {static} + to_static_id(image_num, layer): String
  {static} + to_modular_id(group, num, layer): String
}

ImageId ..> ImageIdKind : uses

CharacterDisplay "1" --> "1" Character : displays
CharacterDisplay "1" *-- "*" DisplayPiece : renders
CharacterDisplay ..> DisplayBuilder : uses

DisplayBuilder ..> DisplayPiece : creates
DisplayBuilder ..> LayerManager : uses
DisplayBuilder ..> ImageId : parses
DisplayBuilder --> EquipmentResult : returns

DisplayBuilder ..> Character : queries
DisplayBuilder ..> SpeciesInstance : queries
DisplayBuilder ..> EquipmentInstance : queries

note right of CharacterDisplay
  Godot Control node that:
  - Renders character visuals
  - Manages TextureRect children
  - Handles horizontal flipping
  - Applies species scale
  - Anchors to bottom-center

  Updates automatically via
  Character.model_changed signal.
end note

note right of DisplayBuilder
  Unified builder replacing:
  - SpeciesDisplayBuilder
  - EquipmentDisplayBuilder
  - SpeciesDisplayable

  Handles:
  - Species body part assembly
  - Equipment layer rendering
  - Color tinting
  - Layer conflict resolution
  - Off-hand transformations
end note

note bottom of DisplayPiece
  Immutable visual layer data:
  - Texture and Z-layer
  - Color modulation
  - Transform (scale, rotation, offset)
  - Flip flags

  Created by DisplayBuilder,
  consumed by CharacterDisplay.
end note

note left of LayerManager
  Layer management utilities:
  - Z-order sorting (0-999)
  - Species/equipment merging
  - Hidden layer filtering
  - Color tint application

  Ensures proper visual stacking
  of body parts and equipment.
end note


@startuml Class-CharacterSystem
!theme plain
title Character System - Class Relationships

class Character {
  - id: String
  - display_name: String
  - skin_color: Color
  - stats: Stats
  - species: SpeciesInstance

  ' Equipment slots
  - head: EquipmentInstance
  - torso: EquipmentInstance
  - arms: EquipmentInstance
  - legs: EquipmentInstance
  - feet: EquipmentInstance
  - main_hand: EquipmentInstance
  - off_hand: EquipmentInstance
  - misc1-4: EquipmentInstance

  - equipment_layer_colors: Dictionary
  - base_verbs: Array[Verb]

  + equip_instance(ei: EquipmentInstance): bool
  + equip_to_hand_slot(ei, slot): bool
  + unequip(slot: int): void
  + get_display_pieces(): Array[DisplayPiece]
  - _recalc_stats(): void
  - _assign_colors_for_equipment_variants(): void

  <<signal>> model_changed
}

class Stats {
  - values: Dictionary
  + get_stat(type: int): int
  + set_stat(type, value): void
  + add_stat(type, amount): void

  <<signal>> changed
}

enum StatType {
  STR
  DEX
  CON
  INT
  WIS
  CHA
}

class SpeciesInstance {
  - base: Species
  - skinColor: Color
  - hairColor: Color
  - eyesColor: Color
  - facialDetailColor: Color

  ' Body parts (resolved from base)
  - backArm: String
  - body: String
  - head: String
  - ears: String
  - eyes: String
  - hair: String
  - facialHair: String
  - facialDetail: String
  - frontArm: String
  - legs: String
  - mouth: String
  - nose: String

  - otherBodyParts: PackedStringArray
  - itemRestrictions: PackedStringArray
  - modular_image_nums: Dictionary
  - skinVariance_resolved: Dictionary

  + from_species(species: Species): void
  + get_variance_color_for_layer(layer): Color
}

class Species <<Resource>> {
  - name: String

  ' Part definitions
  - backArm: String
  - body: String
  - head: String
  - ears: String
  - eyes: String
  - hair: Variant
  - facialHair: String
  - facialDetail: String
  - frontArm: String
  - legs: String
  - mouth: String
  - nose: String

  - otherBodyParts: PackedStringArray
  - itemRestrictions: PackedStringArray

  ' Colors
  - skin_color: PackedStringArray
  - hair_color: PackedStringArray
  - eyes_color: PackedStringArray
  - facialDetail_color: PackedStringArray
  - skinVariance_sets: Array[Dictionary]

  ' Scale
  - x_scale: float
  - y_scale: float
}

class CharacterFactory {
  {static} + create_from_species_instance(si): Character
  {static} + create_random_character(): Character
}

Character "1" *-- "1" Stats : has
Character "1" *-- "1" SpeciesInstance : has
Character "1" o-- "0..11" EquipmentInstance : equips
SpeciesInstance "1" --> "1" Species : based on
CharacterFactory ..> Character : creates
CharacterFactory ..> SpeciesInstance : uses
Stats --> StatType : uses

note right of Character
  Central character class combining:
  - Visual appearance (species)
  - Game stats (D&D style)
  - Equipment slots (11 total)
  - Equipment color assignments

  Emits model_changed signal when
  equipment or stats change.
end note

note right of SpeciesInstance
  Runtime instance of a Species with:
  - Randomized colors
  - Resolved modular parts
  - Skin variance applied

  Allows multiple characters
  of same species to look unique.
end note

@enduml


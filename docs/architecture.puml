@startuml Class-MCPSystem
!theme plain
title MCP (Model Context Protocol) Integration

package "addons/godot_mcp/" {
  class MCPServer {
    - websocket_server: WebSocketServer
    - command_handler: CommandHandler
    - is_running: bool

    + _ready(): void
    + start_server(port): void
    + stop_server(): void
    - _on_message_received(message): void
    - _send_response(response): void
  }

  class WebSocketServer {
    - port: int
    - connections: Array

    + start(port): void
    + stop(): void
    + send_to_all(message): void

    <<signal>> message_received
    <<signal>> client_connected
    <<signal>> client_disconnected
  }

  class CommandHandler {
    - processors: Dictionary

    + register_processor(name, processor): void
    + handle_command(command_data): Variant
    - _route_to_processor(command_name, params): Variant
  }

  class BaseCommandProcessor {
    + process(params: Dictionary): Variant
    # _validate_params(params, required): bool
  }

  package "commands/" {
    class NodeCommands {
      + process(params): Variant
      - create_node(parent_path, type, name): Dictionary
      - delete_node(node_path): Dictionary
      - update_node_property(node_path, prop, value): Dictionary
      - get_node_properties(node_path): Dictionary
      - list_nodes(parent_path): Dictionary
    }

    class SceneCommands {
      + process(params): Variant
      - get_current_scene(): Dictionary
      - create_scene(path, root_type): Dictionary
      - open_scene(path): Dictionary
      - save_scene(path): Dictionary
    }

    class ScriptCommands {
      + process(params): Variant
      - get_script(path): Dictionary
      - create_script(path, content): Dictionary
      - edit_script(path, content): Dictionary
      - create_script_template(type): Dictionary
    }

    class EditorCommands {
      + process(params): Variant
      - get_editor_state(): Dictionary
      - get_selected_node(): Dictionary
      - create_resource(type, path, props): Dictionary
    }

    class ProjectCommands {
      + process(params): Variant
      - get_project_info(): Dictionary
      - get_project_structure(): Dictionary
      - list_project_files(dir, pattern): Dictionary
    }

    class EditorScriptCommands {
      + process(params): Variant
      - execute_editor_script(code): Dictionary
    }
  }
}

MCPServer "1" *-- "1" WebSocketServer : uses
MCPServer "1" *-- "1" CommandHandler : uses

CommandHandler "1" *-- "*" BaseCommandProcessor : manages

NodeCommands --|> BaseCommandProcessor
SceneCommands --|> BaseCommandProcessor
ScriptCommands --|> BaseCommandProcessor
EditorCommands --|> BaseCommandProcessor
ProjectCommands --|> BaseCommandProcessor
EditorScriptCommands --|> BaseCommandProcessor

CommandHandler --> NodeCommands : routes
CommandHandler --> SceneCommands : routes
CommandHandler --> ScriptCommands : routes
CommandHandler --> EditorCommands : routes
CommandHandler --> ProjectCommands : routes
CommandHandler --> EditorScriptCommands : routes

note right of MCPServer
  WebSocket server running on port 9080
